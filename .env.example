# ==============================================================================
# Nexa Loan Management System - Environment Variables Configuration
# ==============================================================================

# Application Environment (development | test | production)
NODE_ENV=development

# Server Port
PORT=3000

# Application Base URL
APP_URL=http://localhost:3000

# Client & API URLs (Public facing URLs for frontend and API endpoints)
CLIENT_URL=http://localhost:3000
API_URL=http://localhost:3000/api

# Vite Frontend Environment Variables (Injected during client build)
VITE_API_URL=/api
VITE_APP_NAME="Nexa Loan Management System"

# ------------------------------------------------------------------------------
# Database Configuration (MySQL)
# ------------------------------------------------------------------------------
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE?connection_limit=10&sslaccept=strict
DATABASE_URL="mysql://db_user:YOUR_STRONG_DB_PASSWORD@localhost:3306/nexa_lms"

# Optional separate MySQL connection parameters for migration scripts
DB_HOST=localhost
DB_PORT=3306
DB_USER=nexa_admin
DB_PASSWORD=YOUR_STRONG_DB_PASSWORD
DB_NAME=nexa_lms

# ------------------------------------------------------------------------------
# Authentication & Security
# ------------------------------------------------------------------------------
# Secret key used for signing JWT tokens (Must be min 32 characters in production)
JWT_SECRET="YOUR_ENTERPRISE_JWT_SECRET_KEY_MIN_32_CHARACTERS"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="YOUR_ENTERPRISE_JWT_REFRESH_SECRET_KEY"
JWT_REFRESH_EXPIRES_IN="7d"

# Bcrypt salt rounds for password hashing (10-12 recommended for production)
BCRYPT_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# Logging & Auditing
# ------------------------------------------------------------------------------
# Log level: error, warn, info, http, verbose, debug
LOG_LEVEL=info
AUDIT_LOG_ENABLED=true

# ------------------------------------------------------------------------------
# CORS Allowed Origins (Comma separated in production)
# ------------------------------------------------------------------------------
CORS_ORIGIN=http://localhost:3000
